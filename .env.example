# ---------------------------------------------------------------------------
# Sendero configuration
#
# Every variable is optional. With none set, Sendero runs as a demo: three
# simulated Outlook mailboxes, the offline classifier, and a mail simulator.
# Each integration switches on when its variables are present; the
# Integrations page shows which are live.
# ---------------------------------------------------------------------------

# Public origin of this deployment. Used for the OAuth redirect URI, the
# Outlook add-in manifest, and absolute links.
APP_ORIGIN=http://localhost:3000

# Where state is kept (JSON, written atomically). Not mail — the mailbox is
# the system of record — but configuration and the agent's decisions.
DATA_DIR=.data

# Times in the console are shown in this zone.
DISPLAY_TIME_ZONE=America/Mexico_City

# --- Microsoft Entra ID / Microsoft Graph ----------------------------------
# App registration: see docs/RUNBOOK.md. Redirect URI to register:
#   ${APP_ORIGIN}/api/auth/microsoft/callback
MS_TENANT_ID=organizations
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# 32 random bytes, base64. Encrypts refresh tokens at rest.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
# Public https origin Graph can POST change notifications to. Without it, new
# mail is picked up by delta sync every 15 minutes instead of within seconds.
# For local development, a tunnel: https://<name>.ngrok.app or a dev tunnel.
GRAPH_NOTIFICATION_ORIGIN=

# --- Language models -------------------------------------------------------
# Any subset. The first configured provider in each order is used; failures
# fall through to the next, and the offline engine is always last.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_TRIAGE_ORDER=anthropic,openai,gemini,offline
AI_DRAFT_ORDER=anthropic,openai,gemini,offline
AI_TIMEOUT_MS=45000

# --- Automation platforms --------------------------------------------------
# Signs outbound rule webhooks (n8n, Power Automate, Zapier):
#   X-Sendero-Signature: sha256=<hex HMAC of the raw body>
WEBHOOK_SIGNING_SECRET=

# --- Console access --------------------------------------------------------
# HTTP Basic in front of the console until SSO is wired to your tenant.
DASHBOARD_USER=
DASHBOARD_PASSWORD=

# --- Demo ------------------------------------------------------------------
# Delivers a new simulated email every N seconds. On by default when Graph is
# not configured.
# SIMULATOR=true
SIMULATOR_INTERVAL_SECONDS=75
